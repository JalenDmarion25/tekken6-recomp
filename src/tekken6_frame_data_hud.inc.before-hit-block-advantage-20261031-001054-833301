#pragma once
bool TekkenFrameDataPracticeActive();
uint64_t TekkenFrameDataResult();
class TekkenFrameDataHud final : public rex::ui::ImGuiDialog {
  ImFont* font_=nullptr;
 public:
  TekkenFrameDataHud(rex::ui::ImGuiDrawer* drawer,ImFont* font):ImGuiDialog(drawer),font_(font){}
 protected:
  void OnDraw(ImGuiIO& io) override {
    if(!TekkenFrameDataPracticeActive())return;
    if(font_)ImGui::PushFont(font_);
    // Below COUNTER/WALL HIT, separated from the bottom native prompts.
    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x*0.07f,io.DisplaySize.y*0.49f),ImGuiCond_Always);
    ImGui::PushStyleColor(ImGuiCol_WindowBg,ImVec4(0.02f,0.06f,0.18f,0.65f));
    ImGui::PushStyleColor(ImGuiCol_Text,ImVec4(1,1,1,1));
    ImGui::PushStyleColor(ImGuiCol_Border,ImVec4(0.01f,0.025f,0.08f,0.95f));
    ImGui::PushStyleColor(ImGuiCol_BorderShadow,ImVec4(0,0.01f,0.04f,0.40f));
    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize,1.0f);
    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding,ImVec2(12,8));
    const auto flags=ImGuiWindowFlags_NoDecoration|ImGuiWindowFlags_AlwaysAutoResize|
      ImGuiWindowFlags_NoNav|ImGuiWindowFlags_NoMove|ImGuiWindowFlags_NoSavedSettings|ImGuiWindowFlags_NoInputs;
    if(ImGui::Begin("##tekken_frame_data",nullptr,flags)) {
      const uint64_t data=TekkenFrameDataResult();
      const unsigned startup=unsigned(data&0xFFFFu);
      if(startup)ImGui::Text("STARTUP       %uF",startup);
      else ImGui::TextUnformatted("STARTUP       --");
      if(data&(uint64_t(1)<<32))ImGui::Text("ON BLOCK      %+dF",int(int16_t((data>>16)&0xFFFFu)));
      else ImGui::TextUnformatted("ON BLOCK      --");
    }
    ImGui::End();ImGui::PopStyleVar(2);ImGui::PopStyleColor(4);
    if(font_)ImGui::PopFont();
  }
};
